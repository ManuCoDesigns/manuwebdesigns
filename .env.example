# EmailJS keys for the contact form (https://dashboard.emailjs.com)
# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# If these are missing, the form falls back to opening the visitor's email app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
